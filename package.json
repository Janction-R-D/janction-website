{
  "private": true,
  "scripts": {
    "start": "cross-env REACT_APP_ENV=dev NODE_OPTIONS=--openssl-legacy-provider umi dev",
    "build": "cross-env REACT_APP_ENV=uat NODE_OPTIONS=--openssl-legacy-provider umi build",
    "postinstall": "umi generate tmp",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ant-design/pro-layout": "^6.5.0",
    "@rainbow-me/rainbowkit": "^2.1.2",
    "@tanstack/react-query": "^5.28.4",
    "animate.css": "^4.1.1",
    "cross-env": "^7.0.3",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "ethers": "5",
    "framer-motion": "^11.2.11",
    "hover.css": "^2.3.2",
    "js-base64": "^3.7.7",
    "numeral": "^2.0.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-lottie": "^1.2.4",
    "siwe": "^2.3.2",
    "umi": "^3.5.41",
    "viem": "2.9.31",
    "wagmi": "^2.9.2"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@umijs/preset-react": "1.x",
    "@umijs/test": "^3.5.41",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.0",
    "typescript": "^4.1.2",
    "yorkie": "^2.0.0"
  }
}
